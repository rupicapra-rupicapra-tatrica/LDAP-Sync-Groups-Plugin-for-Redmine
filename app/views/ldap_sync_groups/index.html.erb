<h2>LDAP Sync Groups Plugin</h2>
<p>Author: Steel..xD | Version <%= Redmine::Plugin.find(:ldap_sync_groups).version %></p>

<%= form_tag({action: 'save'}, method: :post) do %>
  <fieldset>
    <legend>LDAP Authentication (from Redmine)</legend>
    <p>
      <label>LDAP Auth Mode:</label>
      <%= select_tag 'settings[ldap_auth_id]', 
                     options_for_select(@ldap_auths.map { |a| [a.name, a.id] }, @selected_auth_id),
                     include_blank: 'Select LDAP Authentication Mode' %>
      <br/><em>Select the LDAP authentication mode configured in Administration → Authentication modes</em>
    </p>
    <p>
      <button type="button" onclick="showConfig()" style="margin-left: 160px;">📋 Current LDAP Configuration</button>
    </p>
  </fieldset>
  
  <fieldset>
    <legend>LDAP Sync Settings</legend>
    <p>
      <label>Groups DN (optional):</label>
      <%= text_field_tag 'settings[ldap_groups_dn]', LdapSetting.get('ldap_groups_dn'), size: 60, placeholder: 'Leave empty to list all groups in the domain' %>
      <br/><em>Limits the "+ Add" dropdown under Synced Groups to this OU. Example: OU=Groups,DC=domain,DC=com</em>
    </p>
    <p>
      <label>
        <%= hidden_field_tag 'settings[verbose_logging]', 'false' %>
        <%= check_box_tag 'settings[verbose_logging]', 'true', LdapSetting.get('verbose_logging') == 'true' %>
        Verbose Logging
      </label>
      <br/><em>Show detailed member information (useful for debugging)</em>
    </p>
  </fieldset>

  <fieldset>
    <legend>Admin Group</legend>
    <p>
      <label>Redmine admins:</label>
      <%
        admin_options = @ad_groups.map { |g| [g.name, g.guid] }
        # Keep the saved group selectable when AD is unreachable, so saving does not clear it
        if @admin_group_guid.present? && admin_options.none? { |_, guid| guid == @admin_group_guid }
          admin_options.unshift(["#{@admin_group_name.presence || @admin_group_guid} (not loaded from AD)", @admin_group_guid])
        end
      %>
      <%= select_tag 'settings[admin_group_guid]',
                     options_for_select(admin_options, @admin_group_guid),
                     include_blank: 'None - admin rights not managed' %>
      <br/><em>Members of this AD group (including nested groups) become Redmine admins, at every sync and at login. Other users of the selected LDAP authentication mode lose admin rights. Local accounts are never changed.</em>
      <% if @ad_groups_error %>
        <br/><em style="color: #c00;">Could not load groups from AD: <%= @ad_groups_error %></em>
      <% end %>
    </p>
  </fieldset>

  <fieldset>
    <legend>Email Report</legend>
    <p>
      <label>Report Email:</label>
      <%= email_field_tag 'settings[report_email]', LdapSetting.get('report_email'), size: 40, placeholder: 'admin@example.com' %>
      <br/><em>Email address to receive sync reports</em>
    </p>
    <p>
      <label>
        <%= hidden_field_tag 'settings[send_report_only_on_changes]', 'false' %>
        <%= check_box_tag 'settings[send_report_only_on_changes]', 'true', LdapSetting.get('send_report_only_on_changes') == 'true' %>
        Send report only when changes are detected
      </label>
      <br/><em>If unchecked, reports will be sent after every sync</em>
    </p>
  </fieldset>
  
  <div style="margin-top: 20px;">
    <%= submit_tag '💾 Save Settings', class: 'button-positive', style: 'background: #2a6; color: white; padding: 8px 20px; border: none; border-radius: 4px; cursor: pointer; font-size: 14px;' %>
  </div>
<% end %>

<hr />

<h3>Synced Groups</h3>
<p><em>Only these AD groups are synced to Redmine. Members of nested groups count as members.</em></p>
<% if @synced_groups.any? %>
  <table class="list" style="width: auto; min-width: 600px;">
    <thead>
      <tr><th style="text-align: left;">AD group</th><th style="text-align: left;">Redmine group</th><th>Members</th><th></th></tr>
    </thead>
    <tbody>
      <% @synced_groups.each do |link| %>
        <tr>
          <td>
            <%= link.name %>
            <% if @ad_groups.any? && @ad_groups.none? { |g| g.guid == link.guid } %>
              <br/><em style="color: #c00;">Not found in AD - skipped by the sync</em>
            <% end %>
          </td>
          <td><%= link.group ? link_to(link.group.lastname, edit_group_path(link.group)) : content_tag(:em, 'Missing - recreated at the next sync') %></td>
          <td style="text-align: center;"><%= link.group ? link.group.users.count : '-' %></td>
          <td>
            <%= form_tag({action: 'remove_group'}, method: :post, style: 'margin: 0;') do %>
              <%= hidden_field_tag :id, link.id %>
              <%= submit_tag '✖ Remove',
                             data: { confirm: "Remove #{link.name} from the synced groups?\n\nThis DELETES the Redmine group #{link.group&.lastname || link.name}, including the project memberships given through it." },
                             style: 'background: #c00; color: white; padding: 4px 10px; border: none; border-radius: 3px; cursor: pointer;' %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p><em>No groups selected yet. Nothing is synced until you add a group.</em></p>
<% end %>

<%= form_tag({action: 'add_group'}, method: :post, style: 'margin-top: 10px;') do %>
  <% synced_guids = @synced_groups.map(&:guid) %>
  <%= select_tag :guid,
                 options_for_select(@addable_groups.reject { |g| synced_guids.include?(g.guid) }.map { |g| [g.name, g.guid] }),
                 include_blank: 'Select an AD group' %>
  <%= submit_tag '+ Add', style: 'background: #2a6; color: white; padding: 4px 14px; border: none; border-radius: 3px; cursor: pointer;' %>
  <br/><em>Adding a group creates its Redmine group right away. If a Redmine group with the same name exists, it is taken over instead.</em>
  <% if @ad_groups_error %>
    <br/><em style="color: #c00;">Could not load groups from AD: <%= @ad_groups_error %></em>
  <% end %>
<% end %>

<hr />

<!-- Modal pentru Current LDAP Configuration -->
<div id="configModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000;">
  <div style="background: white; width: 600px; margin: 100px auto; padding: 20px; border-radius: 5px; box-shadow: 0 0 10px rgba(0,0,0,0.3);">
    <h3>📋 Current LDAP Configuration</h3>
    <button onclick="closeModal()" style="float: right; background: #c00; color: white; border: none; padding: 5px 10px; cursor: pointer; border-radius: 3px;">✖ Close</button>
    <div style="clear: both;"></div>
    
    <% if @selected_auth_id > 0 && @auth = AuthSourceLdap.find_by(id: @selected_auth_id) %>
      <table style="width: 100%; margin-top: 20px; border-collapse: collapse;">
        <tr><td style="width: 200px; padding: 8px; border-bottom: 1px solid #ddd;"><strong>Name:</strong></td><td style="padding: 8px; border-bottom: 1px solid #ddd;"><%= @auth.name %></td></tr>
        <tr><td style="padding: 8px; border-bottom: 1px solid #ddd;"><strong>Host:</strong></td><td style="padding: 8px; border-bottom: 1px solid #ddd;"><%= @auth.host %>:<%= @auth.port %></td></tr>
        <tr><td style="padding: 8px; border-bottom: 1px solid #ddd;"><strong>Base DN:</strong></td><td style="padding: 8px; border-bottom: 1px solid #ddd;"><%= @auth.base_dn %></td></tr>
        <tr><td style="padding: 8px; border-bottom: 1px solid #ddd;"><strong>Groups DN:</strong></td><td style="padding: 8px; border-bottom: 1px solid #ddd;"><%= LdapSetting.get('ldap_groups_dn').presence || 'NONE (whole domain)' %></td></tr>
        <tr><td style="padding: 8px; border-bottom: 1px solid #ddd;"><strong>Synced Groups:</strong></td><td style="padding: 8px; border-bottom: 1px solid #ddd;"><%= @synced_groups.map(&:name).join(', ').presence || 'NONE' %></td></tr>
        <tr><td style="padding: 8px; border-bottom: 1px solid #ddd;"><strong>Admin Group:</strong></td><td style="padding: 8px; border-bottom: 1px solid #ddd;"><%= @admin_group_name.presence || 'NONE (admin rights not managed)' %></td></tr>
        <tr><td style="padding: 8px; border-bottom: 1px solid #ddd;"><strong>Verbose Logging:</strong></td><td style="padding: 8px; border-bottom: 1px solid #ddd;"><%= LdapSetting.get('verbose_logging') == 'true' ? '✅ Enabled' : '❌ Disabled' %></td></tr>
        <tr><td style="padding: 8px; border-bottom: 1px solid #ddd;"><strong>Report Email:</strong></td><td style="padding: 8px; border-bottom: 1px solid #ddd;"><%= LdapSetting.get('report_email').presence || 'Not configured' %></td></tr>
        <tr><td style="padding: 8px;"><strong>Send on changes only:</strong></td><td style="padding: 8px;"><%= LdapSetting.get('send_report_only_on_changes') == 'true' ? '✅ Yes' : '❌ No' %></td></tr>
      </table>
    <% else %>
      <p style="margin-top: 20px;"><em>No LDAP authentication mode selected.</em></p>
    <% end %>
  </div>
</div>

<hr />

<h3>Synchronization</h3>
<p>
  <%= form_tag({action: 'sync'}, method: :post, style: 'display: inline-block; margin-right: 10px;') do %>
    <%= hidden_field_tag :dry_run, '0' %>
    <%= submit_tag '▶ Run Live Sync', style: 'background: #169; color: white; padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer;' %>
  <% end %>
  
  <%= form_tag({action: 'sync'}, method: :post, style: 'display: inline-block; margin-right: 10px;') do %>
    <%= hidden_field_tag :dry_run, '1' %>
    <%= submit_tag '🔍 Run Dry Run (Test)', style: 'background: #e6b800; color: white; padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer;' %>
  <% end %>
  
  <%= form_tag({action: 'clear_logs'}, method: :post, style: 'display: inline-block;') do %>
    <%= submit_tag '🗑 Clear Logs', style: 'background: #c00; color: white; padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer;' %>
  <% end %>
</p>

<hr />

<h3>Recent Logs</h3>
<% if @logs.any? %>
  <div style="max-height: 400px; overflow-y: auto; background: #f9f9f9; border: 1px solid #ddd; padding: 10px; font-family: monospace; font-size: 12px;">
    <table style="width: 100%;">
      <thead>
        <tr style="background: #ddd;">
          <th style="width: 160px; text-align: left; padding: 5px;">Time</th>
          <th style="text-align: left; padding: 5px;">Message</th>
        </tr>
      </thead>
      <tbody>
        <% @logs.each do |log| %>
          <tr style="<%= 'color: #c00;' if log.message.include?('ERROR') || log.message.include?('Delete group') %><%= 'color: #2a6;' if log.message.include?('Create') || log.message.include?('ADD') %><%= 'color: #82c; font-weight: bold;' if log.message.include?('ADMIN') %><%= 'font-style: italic; background: #fff8dc;' if log.message.start_with?(LdapSyncService::DRY_RUN_PREFIX) %>">
            <td style="white-space: nowrap; padding: 3px 5px;"><%= log.created_at.strftime('%Y-%m-%d %H:%M:%S') %></td>
            <td style="padding: 3px 5px;"><%= log.message %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p><em>No logs available. Run a sync to see results.</em></p>
<% end %>

<script>
function showConfig() {
  document.getElementById('configModal').style.display = 'block';
}

function closeModal() {
  document.getElementById('configModal').style.display = 'none';
}

document.querySelectorAll('input[value="▶ Run Live Sync"]').forEach(btn => {
  btn.closest('form').addEventListener('submit', e => {
    if(!confirm('WARNING: This will make LIVE changes to your Redmine database!\n- Groups will be created/modified\n- Group memberships will be updated\n- Admin rights will be granted/revoked\n\nContinue?')) {
      e.preventDefault();
    }
  });
});

// Close modal when clicking outside
window.onclick = function(event) {
  var modal = document.getElementById('configModal');
  if (event.target == modal) {
    modal.style.display = 'none';
  }
}
</script>

<style>
  .button-positive {
    background: #2a6 !important;
    color: white !important;
    padding: 8px 20px !important;
    border: none !important;
    border-radius: 4px !important;
    cursor: pointer !important;
    font-size: 14px !important;
  }
  .button-positive:hover {
    opacity: 0.9 !important;
  }
  em {
    font-size: 0.9em;
    color: #666;
  }
  fieldset {
    margin-bottom: 20px;
    padding: 15px;
    border: 1px solid #ccc;
    border-radius: 5px;
  }
  legend {
    font-weight: bold;
    padding: 0 10px;
  }
  label {
    display: inline-block;
    width: 220px;
    font-weight: bold;
  }
  p {
    margin: 10px 0;
  }
  button {
    background: #169;
    color: white;
    border: none;
    padding: 5px 15px;
    border-radius: 3px;
    cursor: pointer;
  }
  button:hover {
    opacity: 0.9;
  }
  input[type="checkbox"] {
    width: 18px;
    height: 18px;
    vertical-align: middle;
    margin-right: 8px;
    cursor: pointer;
  }
  input[type="hidden"] + input[type="checkbox"] {
    margin-left: 0;
  }
</style>
